<mxfile host="app.diagrams.net">
  <diagram name="Пользовательский интерфейс" id="ui-v2-extended">
    <mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ui_title" value="Расширенная пользовательская блок-схема Danil AI 1.0" style="text;html=1;fontSize=26;fontStyle=1;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="430" y="30" width="800" height="50" as="geometry"/></mxCell>
        <mxCell id="ui_start" value="Пользователь запускает приложение&#xa;danilAi.py или danilai.exe" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=16;fontStyle=1" vertex="1" parent="1"><mxGeometry x="660" y="100" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="ui_window" value="Открывается главное окно&#xa;Danil AI 1.0&#xa;минимальный размер 1000 x 700" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=15;fontStyle=1" vertex="1" parent="1"><mxGeometry x="625" y="230" width="390" height="105" as="geometry"/></mxCell>
        <mxCell id="ui_title_block" value="Заголовок окна&#xa;Danil AI 1.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14" vertex="1" parent="1"><mxGeometry x="90" y="430" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="ui_info" value="Информационная строка&#xa;нужно установить Ollama&#xa;и выполнить ollama pull llama2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14" vertex="1" parent="1"><mxGeometry x="370" y="415" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="ui_chat" value="Область сообщений QTextBrowser&#xa;показывает историю текущего чата&#xa;сначала: Чат пуст" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14" vertex="1" parent="1"><mxGeometry x="680" y="405" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="ui_input" value="Поле ввода QTextEdit&#xa;пользователь вводит сообщение&#xa;placeholder: Введите сообщение..." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14" vertex="1" parent="1"><mxGeometry x="1020" y="405" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="ui_status" value="Строка состояния&#xa;Готово. Ожидаю сообщение пользователя." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14" vertex="1" parent="1"><mxGeometry x="1360" y="430" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="ui_choice" value="Пользователь выбирает действие" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=15;fontStyle=1" vertex="1" parent="1"><mxGeometry x="705" y="625" width="250" height="135" as="geometry"/></mxCell>
        <mxCell id="ui_send" value="Отправить сообщение&#xa;кнопка Отправить&#xa;или Ctrl+Enter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14" vertex="1" parent="1"><mxGeometry x="130" y="870" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="ui_empty" value="Если поле пустое&#xa;сообщение не отправляется&#xa;статус: Введите сообщение перед отправкой" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14" vertex="1" parent="1"><mxGeometry x="430" y="850" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="ui_wait" value="Если ответ уже формируется&#xa;повторная отправка игнорируется&#xa;кнопка Отправить временно отключена" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14" vertex="1" parent="1"><mxGeometry x="770" y="850" width="310" height="130" as="geometry"/></mxCell>
        <mxCell id="ui_clear" value="Очистить чат&#xa;очищает messages и область сообщений&#xa;если поток работает: показывает предупреждение" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14" vertex="1" parent="1"><mxGeometry x="1120" y="850" width="310" height="130" as="geometry"/></mxCell>
        <mxCell id="ui_close" value="Закрытие окна&#xa;если поток работает: Подождите&#xa;иначе окно закрывается" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14" vertex="1" parent="1"><mxGeometry x="720" y="1080" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="uie1" edge="1" parent="1" source="ui_start" target="ui_window" style="endArrow=block;html=1;rounded=0;strokeColor=#000000"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="uie2" edge="1" parent="1" source="ui_window" target="ui_title_block" style="endArrow=block;html=1;rounded=1;strokeColor=#000000"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="uie3" edge="1" parent="1" source="ui_window" target="ui_info" style="endArrow=block;html=1;rounded=1;strokeColor=#000000"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="uie4" edge="1" parent="1" source="ui_window" target="ui_chat" style="endArrow=block;html=1;rounded=1;strokeColor=#000000"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="uie5" edge="1" parent="1" source="ui_window" target="ui_input" style="endArrow=block;html=1;rounded=1;strokeColor=#000000"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="uie6" edge="1" parent="1" source="ui_window" target="ui_status" style="endArrow=block;html=1;rounded=1;strokeColor=#000000"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="uie7" edge="1" parent="1" source="ui_window" target="ui_choice" style="endArrow=block;html=1;rounded=0;strokeColor=#000000"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="uie8" edge="1" parent="1" source="ui_choice" target="ui_send" value="Отправить" style="endArrow=block;html=1;rounded=1;strokeColor=#000000;fontSize=12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="uie9" edge="1" parent="1" source="ui_choice" target="ui_empty" value="Пустой ввод" style="endArrow=block;html=1;rounded=1;strokeColor=#000000;fontSize=12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="uie10" edge="1" parent="1" source="ui_choice" target="ui_wait" value="Ответ уже идёт" style="endArrow=block;html=1;rounded=1;strokeColor=#000000;fontSize=12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="uie11" edge="1" parent="1" source="ui_choice" target="ui_clear" value="Очистить чат" style="endArrow=block;html=1;rounded=1;strokeColor=#000000;fontSize=12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="uie12" edge="1" parent="1" source="ui_choice" target="ui_close" value="Закрыть" style="endArrow=block;html=1;rounded=1;strokeColor=#000000;fontSize=12"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Внутренняя логика" id="logic-v2-extended">
    <mxGraphModel dx="2300" dy="3500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="3400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="l_title" value="Расширенная внутренняя блок-схема Danil AI 1.0" style="text;html=1;fontSize=26;fontStyle=1;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="540" y="30" width="820" height="50" as="geometry"/></mxCell>
        <mxCell id="l_start" value="Старт программы&#xa;запуск danilAi.py" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=16;fontStyle=1" vertex="1" parent="1"><mxGeometry x="790" y="100" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="l_imports" value="Импорт библиотек&#xa;import html&#xa;import sys&#xa;import requests&#xa;QThread, pyqtSignal&#xa;QFont, QKeySequence, QShortcut&#xa;QApplication, QMainWindow, QWidget, layouts, QLabel, QMessageBox, QPushButton, QTextBrowser, QTextEdit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13" vertex="1" parent="1"><mxGeometry x="665" y="230" width="570" height="180" as="geometry"/></mxCell>
        <mxCell id="l_consts" value="Глобальные настройки Ollama&#xa;OLLAMA_URL = http://localhost:11434/api/chat&#xa;OLLAMA_MODEL = llama2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14" vertex="1" parent="1"><mxGeometry x="705" y="460" width="490" height="100" as="geometry"/></mxCell>
        <mxCell id="l_worker_class" value="class ResponseWorker(QThread)&#xa;отдельный поток для запроса к Ollama&#xa;response_ready = pyqtSignal(str)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="120" y="640" width="360" height="120" as="geometry"/></mxCell>
        <mxCell id="l_assistant_class" value="class DanilAssistant(QMainWindow)&#xa;главное окно приложения&#xa;хранит messages и worker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="770" y="640" width="360" height="120" as="geometry"/></mxCell>
        <mxCell id="l_main_func" value="main()&#xa;создаёт QApplication&#xa;задаёт шрифт&#xa;создаёт DanilAssistant&#xa;window.show()&#xa;sys.exit(app.exec())" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1420" y="620" width="340" height="160" as="geometry"/></mxCell>
        <mxCell id="l_guard" value="if __name__ == &quot;__main__&quot;&#xa;main()" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=15;fontStyle=1" vertex="1" parent="1"><mxGeometry x="790" y="840" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="l_init" value="DanilAssistant.__init__()&#xa;setWindowTitle(&quot;Danil AI 1.0&quot;)&#xa;setMinimumSize(1000, 700)&#xa;messages = []&#xa;worker = None&#xa;init_ui()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13" vertex="1" parent="1"><mxGeometry x="730" y="980" width="440" height="150" as="geometry"/></mxCell>
        <mxCell id="l_ui" value="init_ui() создаёт интерфейс&#xa;central QWidget&#xa;QVBoxLayout root&#xa;title QLabel&#xa;info QLabel&#xa;chat_view QTextBrowser&#xa;input_field QTextEdit&#xa;нижняя панель с кнопками" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13" vertex="1" parent="1"><mxGeometry x="700" y="1190" width="500" height="190" as="geometry"/></mxCell>
        <mxCell id="l_widgets" value="Привязка действий интерфейса&#xa;clear_btn.clicked -> clear_chat&#xa;send_btn.clicked -> send_message&#xa;Ctrl+Return -> send_message&#xa;status_label показывает состояние" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13" vertex="1" parent="1"><mxGeometry x="700" y="1440" width="500" height="130" as="geometry"/></mxCell>
        <mxCell id="l_loop" value="Цикл событий PyQt6&#xa;app.exec()&#xa;ожидание действий пользователя" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=15;fontStyle=1" vertex="1" parent="1"><mxGeometry x="790" y="1640" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="l_event" value="Событие пользователя" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=15;fontStyle=1" vertex="1" parent="1"><mxGeometry x="805" y="1800" width="290" height="120" as="geometry"/></mxCell>
        <mxCell id="l_send_start" value="send_message()&#xa;если worker.isRunning(): return&#xa;получить text из input_field" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13" vertex="1" parent="1"><mxGeometry x="100" y="1990" width="330" height="115" as="geometry"/></mxCell>
        <mxCell id="l_empty" value="Проверка пустого ввода&#xa;if not text:&#xa;status_label = Введите сообщение перед отправкой&#xa;return" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13" vertex="1" parent="1"><mxGeometry x="470" y="1990" width="360" height="125" as="geometry"/></mxCell>
        <mxCell id="l_prepare" value="Подготовка сообщения&#xa;если messages пустой: chat_view.clear()&#xa;input_field.clear()&#xa;messages.append({role: user, content: text})&#xa;append_message(&quot;Вы&quot;, text)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13" vertex="1" parent="1"><mxGeometry x="870" y="1980" width="410" height="145" as="geometry"/></mxCell>
        <mxCell id="l_worker_start" value="Запуск фонового запроса&#xa;status: Отправляю запрос в Ollama...&#xa;send_btn.setEnabled(False)&#xa;worker = ResponseWorker(messages.copy())&#xa;response_ready -> show_response&#xa;finished -> включить кнопку&#xa;worker.start()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13" vertex="1" parent="1"><mxGeometry x="1320" y="1960" width="440" height="190" as="geometry"/></mxCell>
        <mxCell id="l_worker_run" value="ResponseWorker.run()&#xa;requests.post(OLLAMA_URL, json={model, messages, stream: False}, timeout=120)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13" vertex="1" parent="1"><mxGeometry x="1020" y="2230" width="430" height="105" as="geometry"/></mxCell>
        <mxCell id="l_response_check" value="Ответ от Ollama?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1085" y="2410" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="l_ok" value="status_code == 200&#xa;response.json().get(&quot;message&quot;, {}).get(&quot;content&quot;, &quot;&quot;)&#xa;если текст пустой: Ollama вернула пустой ответ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13" vertex="1" parent="1"><mxGeometry x="530" y="2600" width="430" height="130" as="geometry"/></mxCell>
        <mxCell id="l_bad_status" value="Ответ не 200&#xa;текст: Ollama не готова к работе&#xa;проверить запуск Ollama и модель llama2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13" vertex="1" parent="1"><mxGeometry x="1010" y="2600" width="390" height="120" as="geometry"/></mxCell>
        <mxCell id="l_exception" value="except requests.RequestException&#xa;текст: Нет подключения к Ollama&#xa;инструкция: установить Ollama, ollama pull llama2, запустить Ollama" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13" vertex="1" parent="1"><mxGeometry x="1450" y="2590" width="390" height="145" as="geometry"/></mxCell>
        <mxCell id="l_emit" value="response_ready.emit(text)&#xa;передача результата из потока в главное окно" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13" vertex="1" parent="1"><mxGeometry x="1020" y="2820" width="430" height="95" as="geometry"/></mxCell>
        <mxCell id="l_show" value="show_response(text)&#xa;messages.append({role: assistant, content: text})&#xa;append_message(&quot;Danil AI&quot;, text)&#xa;status_label = Готово&#xa;finished включает кнопку Отправить" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13" vertex="1" parent="1"><mxGeometry x="980" y="3000" width="500" height="145" as="geometry"/></mxCell>
        <mxCell id="l_append" value="append_message(author, text)&#xa;html.escape(author)&#xa;html.escape(text).replace(переносы, &lt;br&gt;)&#xa;chat_view.append(...)&#xa;прокрутка вниз" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13" vertex="1" parent="1"><mxGeometry x="120" y="2230" width="390" height="150" as="geometry"/></mxCell>
        <mxCell id="l_clear" value="clear_chat()&#xa;если worker работает: QMessageBox.warning и return&#xa;messages.clear()&#xa;chat_view.setHtml(&quot;Чат очищен...&quot;)&#xa;status_label = Чат очищен" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13" vertex="1" parent="1"><mxGeometry x="80" y="2520" width="390" height="160" as="geometry"/></mxCell>
        <mxCell id="l_close" value="closeEvent(event)&#xa;если worker работает: QMessageBox.warning, event.ignore()&#xa;иначе event.accept()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13" vertex="1" parent="1"><mxGeometry x="80" y="2750" width="390" height="125" as="geometry"/></mxCell>
        <mxCell id="l_return" value="Возврат к циклу событий&#xa;ожидание следующего действия&#xa;или завершение после закрытия окна" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=15;fontStyle=1" vertex="1" parent="1"><mxGeometry x="790" y="3240" width="320" height="95" as="geometry"/></mxCell>
        <mxCell id="le1" edge="1" parent="1" source="l_start" target="l_imports" style="endArrow=block;html=1;rounded=0;strokeColor=#000000"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le2" edge="1" parent="1" source="l_imports" target="l_consts" style="endArrow=block;html=1;rounded=0;strokeColor=#000000"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le3" edge="1" parent="1" source="l_consts" target="l_worker_class" style="endArrow=block;html=1;rounded=1;strokeColor=#000000"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le4" edge="1" parent="1" source="l_consts" target="l_assistant_class" style="endArrow=block;html=1;rounded=1;strokeColor=#000000"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le5" edge="1" parent="1" source="l_consts" target="l_main_func" style="endArrow=block;html=1;rounded=1;strokeColor=#000000"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le6" edge="1" parent="1" source="l_main_func" target="l_guard" style="endArrow=block;html=1;rounded=1;strokeColor=#000000"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le7" edge="1" parent="1" source="l_assistant_class" target="l_init" style="endArrow=block;html=1;rounded=0;strokeColor=#000000"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le8" edge="1" parent="1" source="l_guard" target="l_init" style="endArrow=block;html=1;rounded=0;strokeColor=#000000"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le9" edge="1" parent="1" source="l_init" target="l_ui" style="endArrow=block;html=1;rounded=0;strokeColor=#000000"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le10" edge="1" parent="1" source="l_ui" target="l_widgets" style="endArrow=block;html=1;rounded=0;strokeColor=#000000"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le11" edge="1" parent="1" source="l_widgets" target="l_loop" style="endArrow=block;html=1;rounded=0;strokeColor=#000000"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le12" edge="1" parent="1" source="l_loop" target="l_event" style="endArrow=block;html=1;rounded=0;strokeColor=#000000"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le13" edge="1" parent="1" source="l_event" target="l_send_start" value="Отправить / Ctrl+Enter" style="endArrow=block;html=1;rounded=1;strokeColor=#000000;fontSize=12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le14" edge="1" parent="1" source="l_event" target="l_clear" value="Очистить чат" style="endArrow=block;html=1;rounded=1;strokeColor=#000000;fontSize=12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le15" edge="1" parent="1" source="l_event" target="l_close" value="Закрытие окна" style="endArrow=block;html=1;rounded=1;strokeColor=#000000;fontSize=12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le16" edge="1" parent="1" source="l_send_start" target="l_empty" style="endArrow=block;html=1;rounded=0;strokeColor=#000000"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le17" edge="1" parent="1" source="l_empty" target="l_prepare" value="текст есть" style="endArrow=block;html=1;rounded=0;strokeColor=#000000;fontSize=12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le18" edge="1" parent="1" source="l_prepare" target="l_worker_start" style="endArrow=block;html=1;rounded=0;strokeColor=#000000"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le19" edge="1" parent="1" source="l_worker_start" target="l_worker_run" style="endArrow=block;html=1;rounded=0;strokeColor=#000000"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le20" edge="1" parent="1" source="l_worker_run" target="l_response_check" style="endArrow=block;html=1;rounded=0;strokeColor=#000000"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le21" edge="1" parent="1" source="l_response_check" target="l_ok" value="200" style="endArrow=block;html=1;rounded=1;strokeColor=#000000;fontSize=12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le22" edge="1" parent="1" source="l_response_check" target="l_bad_status" value="не 200" style="endArrow=block;html=1;rounded=1;strokeColor=#000000;fontSize=12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le23" edge="1" parent="1" source="l_worker_run" target="l_exception" value="RequestException" style="endArrow=block;html=1;rounded=1;strokeColor=#000000;fontSize=12"><mxGeometry relative="1" as="geometry"/></mxCell>
